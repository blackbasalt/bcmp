# Copy to .env on the server and fill in real values.
# Generate a key with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=change-me

# Never leave DEBUG on in production
DJANGO_DEBUG=0

# Comma-separated hostnames/IPs the site is served from
DJANGO_ALLOWED_HOSTS=example.com,www.example.com

# Comma-separated origins for CSRF (include scheme)
DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com

# gunicorn tuning (optional)
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=60

# Sentry DSN (optional)
# SENTRY_DSN=
